---
import Layout from '../layouts/Layout.astro';
import CTAButton from '../components/CTAButton.astro';
import TestimonialColumns from '../components/TestimonialColumns.astro';
import { loadRentals } from '../data/rentals';

// Read at build time from public/photos/rentals/. Empty until photos land,
// and the strip below simply doesn't render.
const rentals = loadRentals();
---

<Layout title="Bell of the Ball | Premium Event Design">
  <!-- Hero Section -->
  <section class="hero" id="hero">
    <div class="hero-content">
      <h1 class="hero-title parallax-text" data-speed="0.05">BELL OF<br />THE BALL</h1>
      <p class="hero-tagline reveal">PREMIUM EVENT DESIGN & FULL-SERVICE PLANNING</p>
      <CTAButton href="/contact" class="reveal">Book Consultation</CTAButton>
    </div>
    <div class="hero-media-wrapper reveal-right">
      <img
        class="hero-media shape-1"
        src="/photos/hero/church-garland-arch.jpg"
        alt="A sage-green, gold, and white organic balloon garland arcing over a wooden cross at a stone-walled venue"
      />
    </div>
  </section>

  <!-- About Section -->
  <section class="about" id="about">
    <div class="about-container">
      <span class="section-label reveal">01. HERITAGE & SCOPE</span>
      <div class="about-grid">
        <div class="about-text">
          <h2 class="reveal">Elevating the Art of Celebration</h2>
          <p class="reveal">
            We orchestrate bespoke experiences where crisp editorial lines merge with fluid, organic structures. From
            the initial spark of inspiration to the final toast, our cohesive team handles every detail—ensuring your
            vision is brought to life with uncompromising artistry and deep personalization.
          </p>
          <p class="reveal">
            There is no disconnect between design and execution; we are the single breath of creativity that carries
            your event from concept to reality.
          </p>
          <CTAButton href="/about" variant="secondary" class="reveal">Our Story</CTAButton>
        </div>
        <div class="about-media-blocks">
          <img
            class="media-block block-left shape-2 reveal-up"
            src="/photos/about/wildflower-centerpiece.jpg"
            alt="Wildflowers in glass bottles on a wood-slice centerpiece, table number three"
          />
          <img
            class="media-block block-right shape-3 reveal-up delay-1"
            src="/photos/about/rental-charger-detail.jpg"
            alt="Gold-scroll charger plate with a navy napkin and gold flatware, place setting detail"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section class="services" id="services">
    <div class="services-container">
      <span class="section-label reveal">02. OUR SERVICES</span>

      <div class="service-item service-design reveal">
        <div class="service-text">
          <span class="service-num">01</span>
          <h3>Event Design & Planning</h3>
          <p>
            A holistic approach to celebration. We sculpt space, light, and texture to reflect your unique narrative.
            Comprehensive logistics meet unbridled creativity in our full-service planning.
          </p>
        </div>
        <img
          class="service-media shape-4"
          src="/photos/services/event-design-bridal-table.jpg"
          alt="A long wooden bridal table dressed with a navy and blue floral garland runner, candles, and gold-rimmed place settings"
        />
      </div>

      <div class="service-item service-officiating reveal">
        <img
          class="service-media shape-5"
          src="/photos/services/officiating-ceremony-arch.jpg"
          alt="A wooden circular ceremony arch with sheer draping and oversized poppy flowers, set against a stone building and pine forest"
        />
        <div class="service-text">
          <span class="service-num">02</span>
          <h3>Professional Officiating</h3>
          <p>
            Crafting ceremonies with profound resonance. Our professional officiating services blend tradition with
            modern intimacy, anchoring your milestone in authentic, heartfelt storytelling.
          </p>
        </div>
      </div>

      <div class="service-item service-notary reveal">
        <div class="service-text">
          <span class="service-num">03</span>
          <h3>Notary Services</h3>
        </div>
        <div class="service-text">
          <p>
            A commissioned notary on the same team that plans your event. Marriage licenses, affidavits, and the
            paperwork that tends to surface the week of — handled without sending you to find a third party at short
            notice.
          </p>
        </div>
      </div>

      <div class="service-item service-balloons reveal">
        <div class="service-text">
          <span class="service-num">04</span>
          <h3>Organic Balloon Arrangements</h3>
          <p>
            Defying gravity and expectation. We weave kinetic, botanical-inspired balloon installations that climb
            architecture and cascade through spaces in breathtaking asymmetry.
          </p>
        </div>
        <img
          class="service-media shape-6"
          src="/photos/services/balloons-purple-wisteria.jpg"
          alt="A purple and lavender organic balloon garland with wisteria accents arcing over a wooden cross at a stone-walled venue"
        />
      </div>

      <div class="service-item service-rentals reveal">
        <div class="rental-background"></div>
        <div class="service-text centered-text">
          <span class="service-num">05</span>
          <h3>Party Concession Rentals</h3>
          <p>Curated amusements for the discerning host. Concession equipment delivered and set up to match your event's own palette and pace.</p>
        </div>
      </div>

      {rentals.length > 0 && (
        <ul class="rental-strip reveal">
          {rentals.map((machine) => (
            <li class="rental-card">
              <img src={machine.src} alt={machine.alt} loading="lazy" />
              <span class="label-text rental-name">{machine.name}</span>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <!-- Portfolio Teaser -->
  <section class="portfolio" id="portfolio">
    <div class="portfolio-container">
      <span class="section-label reveal">03. ARCHIVE</span>
      <h2 class="portfolio-title reveal">Selected Works</h2>
      <div class="portfolio-grid">
        <div class="portfolio-item p-item-1 reveal-up">
          <img
            class="p-media shape-7"
            src="/photos/featured/mr-and-mrs-tablescape.jpg"
            alt="A rustic wedding place setting with a wood charger, sage tablecloth, and a gold Mr. and Mrs. sign against a stone wall"
          />
          <span class="p-caption">RUSTIC WEDDING</span>
        </div>
        <div class="portfolio-item p-item-2 reveal-up delay-1">
          <img
            class="p-media shape-8"
            src="/photos/featured/winter-snowflake-arch.jpg"
            alt="A blue and silver balloon arch with star and snowflake accents inside a boutique interior"
          />
          <span class="p-caption">WINTER LAUNCH</span>
        </div>
        <div class="portfolio-item p-item-3 reveal-up delay-2">
          <img
            class="p-media shape-9"
            src="/photos/featured/jungle-baby-shower-garland.jpg"
            alt="A sage green and gold balloon garland framing a jungle-themed baby shower backdrop reading A Little King is on His Way"
          />
          <span class="p-caption">BABY SHOWER</span>
        </div>
        <div class="portfolio-item p-item-4 reveal-up delay-1">
          <img
            class="p-media shape-10"
            src="/photos/featured/gala-ballroom-tablescape.jpg"
            alt="A black, gold, and purple place setting at a formal ballroom gala table"
          />
          <span class="p-caption">CORPORATE GALA</span>
        </div>
      </div>
      <div class="mt-24 text-center">
        <CTAButton href="/portfolio" variant="secondary">View Full Archive</CTAButton>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <TestimonialColumns />

  <!-- Final CTA Section -->
  <section class="final-cta" id="contact">
    <div class="cta-container reveal">
      <h2 class="cta-title">Your Vision,<br />Our Craft</h2>
      <CTAButton href="/contact" variant="secondary">Book Consultation</CTAButton>
    </div>
  </section>

  <button type="button" class="to-top" data-to-top hidden aria-label="Back to top">
    <span aria-hidden="true">↑</span>
    <span class="to-top-label">TOP</span>
  </button>
</Layout>
